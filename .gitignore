# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checkers
.mypy_cache/
.ruff_cache/
.pytype/

# Secrets -- never commit these
.env
.env.*
!.env.example
*.pem

# Editors / OS
.idea/
.vscode/
.DS_Store
*.swp

# Local student data: books, index and memory are private by default
.studybuddy/
tests/.studybuddy/
