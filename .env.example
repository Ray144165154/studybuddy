# Copy to .env (never commit it) or export these in your shell.

# Any OpenAI-compatible provider works.
STUDYBUDDY_API_KEY=sk-...
# STUDYBUDDY_BASE_URL=https://api.deepseek.com/v1
# STUDYBUDDY_MODEL=deepseek-chat

# DeepSeek example:
#   export STUDYBUDDY_API_KEY=sk-...
#   export STUDYBUDDY_BASE_URL=https://api.deepseek.com/v1
#   export STUDYBUDDY_MODEL=deepseek-chat

# Local Ollama example (no key needed):
#   export STUDYBUDDY_BASE_URL=http://127.0.0.1:11434/v1
#   export STUDYBUDDY_MODEL=llama3.1
